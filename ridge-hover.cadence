bot Ridge Hover
modes 3d
rulesets gravity-flat gravity-hills
initial climb

# The target altitude is terrain-relative, so the same program clears hills.
state climb
  each lift clamp((0 - gravity-z) / 110 + (terrain-height + 105 - z) / 110 - vz / 65, -1, 1)
  each thrust 0.48
  each yaw-torque 0.18
  each scan-heading sweep(7)
  each scan-pitch wave(32, 20)
  each scan-arc 64
  when z > terrain-height + 90 -> cruise
end

state cruise
  each lift clamp((0 - gravity-z) / 110 + (terrain-height + 105 - z) / 120 - vz / 70, -1, 1)
  each thrust 0.52
  each yaw-torque 0.16
  each scan-heading sweep(7)
  each scan-pitch wave(32, 20)
  each scan-arc 64
  when grounded -> climb
end
